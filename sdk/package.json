{
  "name": "@freya-codex/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Designer Hub on-chain primitive on Monad: passkey (WebAuthn/P-256) smart accounts, provenance attestation, and remixable design-scheme assets with lineage revenue-splitting.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "author": "Designer Hub",
  "homepage": "https://designerhub.asia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freya-Codex/DesignerHub-MonadMetropolis.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/Freya-Codex/DesignerHub-MonadMetropolis/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "monad",
    "webauthn",
    "passkey",
    "p256",
    "erc-4337-free",
    "smart-account",
    "provenance",
    "erc-721",
    "lineage",
    "revenue-split"
  ]
}
