# ---- 链上合约地址（部署后填入，部署脚本输出见 contracts/deployments/monad-testnet.json）----
NEXT_PUBLIC_DREAMSCHEME_ADDRESS=
NEXT_PUBLIC_SCHEME_MARKET_ADDRESS=
# 单次「应用到我家」的价格（MON，默认 0.01）
NEXT_PUBLIC_APPLY_PRICE_ETH=0.01

# RainbowKit / WalletConnect（可先留空，MetaMask 注入模式不影响使用）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS 网关（读取 ipfs:// 元数据用）
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Pinata（创建/Seed 时固定方案 JSON 与预览图；留空则进入本地 local:// 演示模式）
PINATA_KEY=
PINATA_SECRET=
# 可选：新版 Pinata JWT（与 KEY/SECRET 二选一，优先使用）
PINATA_JWT=

# Kimi/Moonshot（装修建议接口；留空则使用内置规则引擎）
KIMI_API_KEY=

# ---- Seed / 部署脚本使用 ----
# 铸造私钥（测试网，勿提交真实私钥）
MONAD_PRIVATE_KEY=
