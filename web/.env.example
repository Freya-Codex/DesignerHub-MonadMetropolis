# ---- 五个链上合约地址（部署后填入，见 contracts/deployments/monad-testnet.json）----
NEXT_PUBLIC_DREAM_SCHEME_ADDRESS=
NEXT_PUBLIC_SCHEME_MARKET_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PROVENANCE_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSKEY_FACTORY_ADDRESS=
# 画廊索引的部署起始区块
NEXT_PUBLIC_DEPLOY_BLOCK=
# RainbowKit / WalletConnect（可先留空，MetaMask 注入模式不影响使用）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS 网关（读取 ipfs:// 元数据用）
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- 链上活动索引（/mint 与 /trades 的流水）----
# 前端「尾部窗口」实时扫描的区块跨度（默认 2000，仅用于捕获刚发生的活动）
NEXT_PUBLIC_TAIL_SCAN_BLOCKS=2000

# Pinata（创建/Seed 时固定方案 JSON 与预览图；留空则进入本地 local:// 演示模式）
PINATA_KEY=
PINATA_SECRET=
# 可选：新版 Pinata JWT（与 KEY/SECRET 二选一，优先使用）
PINATA_JWT=

# Kimi/Moonshot（装修建议接口；留空则使用内置规则引擎）
KIMI_API_KEY=

# ---- Seed / 部署脚本使用 ----
# 铸造私钥（测试网，勿提交真实私钥）
MONAD_PRIVATE_KEY=

# ---- Passkey（无助记词账户，主流程）----
# RP ID：WebAuthn 的注册域（不含协议/端口）。留空 → 自动取当前访问域名（localhost 打开即 localhost）
NEXT_PUBLIC_PASSKEY_RP_ID=
# RP 展示名（创建 passkey 时的 rp.name）
NEXT_PUBLIC_PASSKEY_RP_NAME=Designer Hub
# Origin：留空 → 自动取当前站点 origin（如 http://localhost:3005）
NEXT_PUBLIC_PASSKEY_ORIGIN=

# ---- Relayer（演示级 gas sponsor，留空则自动关闭）----
# 代付 gas 的测试网私钥（勿用主网、勿提交）。留空时回退到 MONAD_PRIVATE_KEY
RELAYER_PRIVATE_KEY=
# 每日全局额度 / 单账户每日额度（进程内计数，重启清零）
RELAYER_MAX_PER_DAY=200
RELAYER_MAX_PER_ACCOUNT_PER_DAY=10

# ---- Alchemy（可选：服务端数据层，Alchemy RPC + Webhook）----
# ⚠️ 仅服务端使用，Key 不要加 NEXT_PUBLIC_ 前缀（否则会打进前端 bundle＝泄露）。
# 前端始终走公共 RPC（零密钥）；服务端（relay / 离线索引 / Webhook 接收端）走 Alchemy。
# 留空 → 全部回退公共 RPC，站点照常工作。
ALCHEMY_API_KEY=
# 可选：直接指定 Alchemy RPC URL（优先于上面的 Key 拼接）
ALCHEMY_RPC_URL=
# 可选：覆盖 Alchemy Monad 主机前缀（默认 https://monad-testnet.g.alchemy.com/v2）
ALCHEMY_MONAD_HOST=
# Alchemy Webhook 签名密钥（Dashboard 创建 Address Activity Webhook 时生成，用于校验回调签名）
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ---- Envio HyperSync / HyperRPC（可选：服务端链上数据索引层）----
# ⚠️ 仅服务端使用，不要加 NEXT_PUBLIC_ 前缀（否则会打进前端 bundle＝泄露）。
# 配置后：离线索引 scripts/index-activity.ts 走 HyperSync 一次拉全量历史，
# 服务端 RPC 增加 HyperRPC 作为 Alchemy 之后、公共 RPC 之前的兜底。
# 留空 → 回退公共 RPC 分片扫描，站点照常工作。
# 令牌从 Envio Cloud 控制台获取（https://envio.dev/app）。
ENVIO_API_TOKEN=
# 可选：覆盖默认 Monad Testnet 端点
ENVIO_HYPERSYNC_URL=
ENVIO_HYPERRPC_URL=
# Envio 索引器产出的 GraphQL 端点（只读、无密钥，可公开）；供前端活动层查询
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
