# ---- 链上合约地址（部署后填入，部署脚本输出见 contracts/deployments/monad-testnet.json）----
NEXT_PUBLIC_VIRTUHOME_SCHEME_ADDRESS=
NEXT_PUBLIC_SCHEME_MARKET_ADDRESS=
# 单次「应用到我家」的价格（MON，默认 0.01）
NEXT_PUBLIC_APPLY_PRICE_ETH=0.01

# RainbowKit / WalletConnect（可先留空，MetaMask 注入模式不影响使用）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS 网关（读取 ipfs:// 元数据用）
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- 链上活动索引（/mint 与 /trades 的流水）----
# 部署块：离线索引（scripts/index-activity.ts）与实时扫描的起点，部署脚本会输出
NEXT_PUBLIC_DEPLOY_BLOCK=
# 前端「尾部窗口」实时扫描的区块跨度（默认 2000，仅用于捕获刚发生的活动）
NEXT_PUBLIC_TAIL_SCAN_BLOCKS=2000

# Pinata（创建/Seed 时固定方案 JSON 与预览图；留空则进入本地 local:// 演示模式）
PINATA_KEY=
PINATA_SECRET=
# 可选：新版 Pinata JWT（与 KEY/SECRET 二选一，优先使用）
PINATA_JWT=

# Kimi/Moonshot（装修建议接口；留空则使用内置规则引擎）
KIMI_API_KEY=

# ---- Seed / 部署脚本使用 ----
# 铸造私钥（测试网，勿提交真实私钥）
MONAD_PRIVATE_KEY=

# ---- Passkey（无助记词账户，主流程）----
# RP ID：WebAuthn 的注册域（不含协议/端口）。留空 → 自动取当前访问域名（localhost 打开即 localhost）
NEXT_PUBLIC_PASSKEY_RP_ID=
# RP 展示名（创建 passkey 时的 rp.name）
NEXT_PUBLIC_PASSKEY_RP_NAME=Designer Hub
# Origin：留空 → 自动取当前站点 origin（如 http://localhost:3005）
NEXT_PUBLIC_PASSKEY_ORIGIN=

# ---- Relayer（演示级 gas sponsor，留空则自动关闭）----
# 代付 gas 的测试网私钥（勿用主网、勿提交）。留空时回退到 MONAD_PRIVATE_KEY
RELAYER_PRIVATE_KEY=
# 每日全局额度 / 单账户每日额度（进程内计数，重启清零）
RELAYER_MAX_PER_DAY=200
RELAYER_MAX_PER_ACCOUNT_PER_DAY=10
