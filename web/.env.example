# ---- The five on-chain contract addresses (fill in after deployment; see contracts/deployments/monad-testnet.json) ----
NEXT_PUBLIC_DREAM_SCHEME_ADDRESS=
NEXT_PUBLIC_SCHEME_MARKET_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_PROVENANCE_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSKEY_FACTORY_ADDRESS=
# Deployment start block for the gallery index
NEXT_PUBLIC_DEPLOY_BLOCK=
# RainbowKit / WalletConnect (can be left blank; MetaMask injected mode still works)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# IPFS gateway (for reading ipfs:// metadata)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---- On-chain activity index (the /mint and /trades feed) ----
# Block span for the front end's "tail window" live scan (default 2000; only to catch just-happened activity)
NEXT_PUBLIC_TAIL_SCAN_BLOCKS=2000

# Pinata (pins scheme JSON & preview images on create/seed; blank -> local local:// demo mode)
PINATA_KEY=
PINATA_SECRET=
# Optional: newer Pinata JWT (alternative to KEY/SECRET; takes precedence)
PINATA_JWT=

# Kimi/Moonshot (renovation-advice endpoint; blank -> built-in rule engine)
KIMI_API_KEY=

# ---- For seed / deployment scripts ----
# Mint private key (testnet; never commit a real private key)
MONAD_PRIVATE_KEY=

# ---- Passkey (seedless account, main flow) ----
# RP ID: the WebAuthn registration domain (no scheme/port). Blank -> auto from the current host (localhost when opened via localhost)
NEXT_PUBLIC_PASSKEY_RP_ID=
# RP display name (rp.name when creating a passkey)
NEXT_PUBLIC_PASSKEY_RP_NAME=Designer Hub
# Origin: blank -> auto from the current site origin (e.g. http://localhost:3005)
NEXT_PUBLIC_PASSKEY_ORIGIN=

# ---- Relayer (demo-grade gas sponsor; blank disables it) ----
# Testnet private key that pays for gas (never mainnet, never commit). Blank falls back to MONAD_PRIVATE_KEY
RELAYER_PRIVATE_KEY=
# Daily global quota / per-account daily quota (in-process counter; reset on restart)
RELAYER_MAX_PER_DAY=200
RELAYER_MAX_PER_ACCOUNT_PER_DAY=10

# ---- Alchemy (optional: server-side data layer, Alchemy RPC + Webhook) ----
# WARNING: server-side only; do not add a NEXT_PUBLIC_ prefix to the Key (otherwise it is bundled into the front end = leak).
# The front end always uses the public RPC (zero keys); the server (relay / offline index / webhook receiver) uses Alchemy.
# Blank -> everything falls back to the public RPC; the site works as usual.
ALCHEMY_API_KEY=
# Optional: specify the Alchemy RPC URL directly (takes precedence over the Key above)
ALCHEMY_RPC_URL=
# Optional: override the Alchemy Monad host prefix (default https://monad-testnet.g.alchemy.com/v2)
ALCHEMY_MONAD_HOST=
# Alchemy Webhook signing key (generated when creating an Address Activity Webhook in the Dashboard; used to verify callback signatures)
ALCHEMY_WEBHOOK_SIGNING_KEY=

# ---- Envio HyperSync / HyperRPC (optional: server-side on-chain data index layer) ----
# WARNING: server-side only; do not add a NEXT_PUBLIC_ prefix (otherwise it is bundled into the front end = leak).
# Once configured: the offline index scripts/index-activity.ts pulls the full history via HyperSync in one pass,
# and the server adds HyperRPC as a fallback after Alchemy and before the public RPC.
# Blank -> falls back to public-RPC chunked scanning; the site works as usual.
# Obtain the token from the Envio Cloud console (https://envio.dev/app).
ENVIO_API_TOKEN=
# Optional: override the default Monad Testnet endpoint
ENVIO_HYPERSYNC_URL=
ENVIO_HYPERRPC_URL=
# GraphQL endpoint produced by the Envio indexer (read-only, keyless, public); queried by the front-end activity layer
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
