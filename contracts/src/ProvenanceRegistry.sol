pragma solidity ^0.8.24;

import {AgentRegistry} from "./AgentRegistry.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";

/// @title ProvenanceRegistry — the attestation registry for AI-generated content (the protocol's lead role)
///
/// @notice ## Privacy model (Privacy by Design)
///
/// Only a "commitment" is stored on-chain; no scheme content is stored:
///
///     commitment = keccak256(abi.encodePacked(contentHash, salt))
///
///   - contentHash = keccak256(canonicalJSON(scheme)) — room geometry, furniture lists and all
///     raw data live only on IPFS (optional) and the user's local device, never on-chain;
///   - salt is randomly generated by the user — even if two schemes have identical content, the commitments
///     differ, so on-chain data cannot be used to correlate content;
///   - verification: anyone can take the raw JSON + salt, recompute the commitment locally and compare it
///     against the chain, proving "content not tampered + the attestation timestamp".
///
/// @notice ## Gasless (relayer pays)
///
/// An EOA user authorizes a single attestation request with an EIP-712 typed signature; the relayer
/// submits it and pays gas:
///
///     attestByRelayer(AttestRequest, signature)
///
///     struct AttestRequest {
///         address attestor;      // signer = attestor
///         bytes32 commitment;    // content commitment
///         uint256 agentId;       // AI attribution (0 = none)
///         string  metadataURI;   // optional metadata (ipfs://)
///         uint256 nonce;         // replay protection
///         uint256 deadline;      // signature validity
///     }
///
/// Passkey users have their P256PasskeyAccount.execute submit it instead (also gasless);
/// the signature authorizes "the exact operation + nonce", so the relayer cannot tamper with it.
///
/// @dev Non-upgradeable; the commitment is globally unique (a commitment can only be attested once).
contract ProvenanceRegistry {
    using ECDSA for bytes32;

    AgentRegistry public immutable agentRegistry;
    bytes32 public immutable DOMAIN_SEPARATOR;

    struct Attestation {
        address attestor; // the attestor
        uint256 agentId; // AI attribution (0 = human original / undeclared)
        uint64 attestedAt; // attestation time
        bool exists;
    }

    struct AttestRequest {
        address attestor;
        bytes32 commitment;
        uint256 agentId;
        string metadataURI;
        uint256 nonce;
        uint256 deadline;
    }

    /// @notice commitment → attestation record.
    mapping(bytes32 => Attestation) public attestations;
    /// @notice per-attestor signature nonce in relayer mode (replay protection).
    mapping(address => uint256) public nonces;

    event Attested(address indexed attestor, bytes32 indexed commitment, uint256 indexed agentId, string metadataURI);

    error AlreadyAttested(bytes32 commitment);
    error AgentNotRegistered(uint256 agentId);
    error Expired(uint256 deadline);
    error InvalidSigner(address recovered, address expected);
    error BadNonce(uint256 provided, uint256 expected);
    error NotAttested(bytes32 commitment);

    bytes32 private constant ATTEST_REQUEST_TYPEHASH = keccak256(
        "AttestRequest(address attestor,bytes32 commitment,uint256 agentId,string metadataURI,uint256 nonce,uint256 deadline)"
    );

    constructor(AgentRegistry _agentRegistry) {
        agentRegistry = _agentRegistry;
        DOMAIN_SEPARATOR = keccak256(
            abi.encode(
                keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
                keccak256(bytes("ProvenanceRegistry")),
                keccak256(bytes("1")),
                block.chainid,
                address(this)
            )
        );
    }

    // ------------------------------------------------------------------ //
    //                        Attestation entry                          //
    // ------------------------------------------------------------------ //

    /// @notice Attest directly (EOA / smart account paying its own gas).
    /// @param commitment keccak256(abi.encodePacked(contentHash, salt)).
    /// @param agentId the AI agent that generated the content; 0 means no attribution, >0 must be registered.
    /// @param metadataURI optional metadata URI (ipfs://...); may be an empty string.
    function attest(bytes32 commitment, uint256 agentId, string calldata metadataURI) external {
        _attest(msg.sender, commitment, agentId, metadataURI);
    }

    /// @notice Relayer-paid attestation: EIP-712 signature authorization, submitted by the relayer.
    function attestByRelayer(AttestRequest calldata request, bytes calldata signature) external {
        if (block.timestamp > request.deadline) revert Expired(request.deadline);
        if (request.nonce != nonces[request.attestor]) {
            revert BadNonce(request.nonce, nonces[request.attestor]);
        }
        bytes32 structHash = keccak256(
            abi.encode(
                ATTEST_REQUEST_TYPEHASH,
                request.attestor,
                request.commitment,
                request.agentId,
                keccak256(bytes(request.metadataURI)),
                request.nonce,
                request.deadline
            )
        );
        bytes32 digest = keccak256(abi.encodePacked("\x19\x01", DOMAIN_SEPARATOR, structHash));
        address recovered = digest.recover(signature);
        if (recovered != request.attestor) revert InvalidSigner(recovered, request.attestor);
        nonces[request.attestor] = request.nonce + 1;
        _attest(request.attestor, request.commitment, request.agentId, request.metadataURI);
    }

    function _attest(address attestor, bytes32 commitment, uint256 agentId, string memory metadataURI) private {
        if (attestations[commitment].exists) revert AlreadyAttested(commitment);
        if (agentId != 0 && !agentRegistry.isRegistered(agentId)) revert AgentNotRegistered(agentId);

        attestations[commitment] =
            Attestation({attestor: attestor, agentId: agentId, attestedAt: uint64(block.timestamp), exists: true});

        // AI attribution reputation: accrued on attestation (only this contract can call addReputation)
        if (agentId != 0) {
            agentRegistry.addReputation(agentId);
        }

        emit Attested(attestor, commitment, agentId, metadataURI);
    }

    // ------------------------------------------------------------------ //
    //                          Verification                             //
    // ------------------------------------------------------------------ //

    /// @notice Look up the attestation status of a commitment (used by verifiers / SDK).
    function verify(bytes32 commitment)
        external
        view
        returns (bool exists, address attestor, uint256 agentId, uint64 attestedAt)
    {
        Attestation storage a = attestations[commitment];
        return (a.exists, a.attestor, a.agentId, a.attestedAt);
    }

    /// @notice Compute the EIP-712 digest of an AttestRequest (used by the SDK / tests).
    function attestRequestDigest(AttestRequest calldata request) external view returns (bytes32) {
        bytes32 structHash = keccak256(
            abi.encode(
                ATTEST_REQUEST_TYPEHASH,
                request.attestor,
                request.commitment,
                request.agentId,
                keccak256(bytes(request.metadataURI)),
                request.nonce,
                request.deadline
            )
        );
        return keccak256(abi.encodePacked("\x19\x01", DOMAIN_SEPARATOR, structHash));
    }
}
